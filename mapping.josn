[{
	"Source": "CBS",
	"SourceFileName":"BankBranch.xlsx",
    "ShortName": "BRANCH",
	"SourceFileType": "xlsx",
    "SLocation": "/assets/AML/landing/",
    "DestFileName": "",
    "DestFileType": "parquet",
    "DLocation": "C:/#ShortName#/#Source#/#year#/#month#/#date#/", 
	"targetTable": "public.fs_branch",	
	"keyColumns": ["branchcode"], 
	"columns": [
		{ "from": "BRANCHCODE", "to": "branchcode", "type": "STRING" },
		{ "from": "BRANCHNAME", "to": "branchname", "type": "STRING" },
		{ "from": "BANKCODE", "to": "bankcode", "type": "STRING" }
	],
	"mode": "UPSERT",         
	"onError": "ROW_TO_DLQ"   
},
{
	"Source": "CBS",
	"SourceFileName":"Accounts.xlsx",
	"ShortName": "Accounts",
	"SourceFileType": "xlsx",
    "SLocation": "/assets/AML/landing/",
    "DestFileName": "",
    "DestFileType": "parquet",
    "DLocation": "C:/#ShortName#/#Source#/#year#/#month#/#date#/",
	"targetTable": "public.fs_account_details",
	"keyColumns": ["accountno"], 
	"columns": [
		{ "from": "ACCTNO", "to": "accountno", "type": "STRING" },
		{ "from": "CUSTCD", "to": "customerid", "type": "STRING" },
		{ "from": "PLAN_TYPE", "to": "accounttype", "type": "STRING" },
		{ "from": "BRANCHCODE", "to": "branchcode", "type": "STRING" },
		{ "from": "OPENDATE", "to": "AccountOpenedDate", "type": "STRING"},
		{ "from": "STATUS", "to": "Status", "type": "STRING"},
		{ "from": "STATUS", "to": "Status", "type": "STRING"}
	],
  "mode": "UPSERT",         
  "onError": "ROW_TO_DLQ"   
},
{
	"Source": "CBS",
	"SourceFileName":"Customers.xlsx",
	"ShortName": "Customers",
	"SourceFileType": "xlsx",
    "SLocation": "/assets/AML/landing/",
    "DestFileName": "",
    "DestFileType": "parquet",
    "DLocation": "C:/#ShortName#/#Source#/#year#/#month#/#date#/",
	"targetTable": "public.fs_cust",
	"keyColumns": ["customerid"], 
	"columns": [
		{ "from": "CUSTNO", "to": "customerid", "type": "STRING" },
		{ "from": "CUSTNAME", "to": "customername", "type": "STRING" },
		{ "from": "CUSTTYPE", "to": "customertype", "type": "STRING" },
		{ "from": "COMPANYCAT", "to": "customercategory", "type": "STRING" },
		{ "from": "BRCD", "to": "branchcode", "type": "STRING" },
		{ "from": "TYPEOFBUSINESS", "to": "natureofbusiness", "type": "STRING" },
		{ "from": "CBS_RISK_RATING", "to": "creditrating", "type": "STRING" },
		{ "from": "UPDATEDATE", "to": "createddatetime", "type": "STRING" },
		{ "from": "FIRSTNAME", "to": "firstname", "type": "STRING" },
		{ "from": "LASTNAME", "to": "lastname", "type": "STRING" },
		{ "from": "DOB", "to": "dateofbirth", "type": "STRING" },
		{ "from": "PLACEOFBIRTH", "to": "placeofbirth", "type": "STRING" },
		{ "from": "NATIONALITY", "to": "nationality", "type": "STRING" },
		{ "from": "DOB", "to": "age", "type": "STRING" },
		{ "from": "GENDER", "to": "sex", "type": "STRING" },
		{ "from": "IDENTIFICATIONVAL1", "to": "panno", "type": "STRING" },
		{ "from": "OCCUPATION", "to": "occupation", "type": "STRING" },
		{ "from": "COUNTRYRESIDENCE", "to": "city", "type": "STRING" },
		{ "from": "COUNTRYOFREG", "to": "country", "type": "STRING" },
		{ "from": "PHONENO", "to": "phoneno", "type": "STRING" },	
		{ "from": "MOBILENO", "to": "mobileno", "type": "STRING" },
		{ "from": "EMAILID", "to": "emailid", "type": "STRING" }
	  ],
	"mode": "UPSERT",         
	"onError": "ROW_TO_DLQ"   
},
{
